# Temple Vault .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Vault is PUBLIC - the memory is shared
# Only ignore cache (reconstructible) and locks (runtime)
vault/cache/
vault/locks/

# Project-specific data (optional privacy)
# Uncomment to keep private:
# global/
# projects/

# Locks (runtime only)
*.lock
.lock/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db
